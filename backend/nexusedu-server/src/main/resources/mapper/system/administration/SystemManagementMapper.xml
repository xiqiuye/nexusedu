<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xqy.nexusedu.system.administration.infrastructure.persistence.SystemManagementMapper">
    <sql id="table">
        <choose>
            <when test="resource == 'users'">sys_user</when>
            <when test="resource == 'roles'">sys_role</when>
            <when test="resource == 'menus'">sys_menu</when>
            <when test="resource == 'buttons'">sys_button</when>
            <when test="resource == 'sessions'">sys_user_session</when>
            <otherwise>sys_user</otherwise>
        </choose>
    </sql>
    <sql id="columns">
        <choose>
            <when test="resource == 'users'">id,tenant_id,username,nickname,real_name,email,phone,avatar,user_type,status,last_login_time,last_login_ip,create_time,update_time</when>
            <when test="resource == 'roles'">id,role_code,role_name,description,role_type,status,create_time,update_time</when>
            <when test="resource == 'menus'">id,parent_id,path,route_name,component,redirect,title,icon,sort_no,keep_alive,visible,hide_tab,full_page,external_link,iframe_flag,active_path,status</when>
            <when test="resource == 'buttons'">id,menu_id,button_name,auth_remark,description,sort_no,status</when>
            <when test="resource == 'sessions'">id,tenant_id,user_id,login_ip,user_agent,device_type,login_time,expire_time,refresh_expire_time,status,logout_time</when>
            <otherwise>id</otherwise>
        </choose>
    </sql>
    <sql id="filters">
        <where>
            <if test="resource == 'users' or resource == 'sessions'">tenant_id=#{tenantId}</if>
            <if test="userId != null">AND user_id=#{userId}</if>
            <if test="status != null and status != ''">AND status=#{status}</if>
            <if test="resource == 'buttons' and menuId != null">AND menu_id=#{menuId}</if>
            <if test="search != null and search != ''">
                <choose>
                    <when test="resource == 'users'">AND username LIKE CONCAT('%',#{search},'%')</when>
                    <when test="resource == 'roles'">AND role_name LIKE CONCAT('%',#{search},'%')</when>
                    <when test="resource == 'menus'">AND title LIKE CONCAT('%',#{search},'%')</when>
                    <when test="resource == 'buttons'">AND button_name LIKE CONCAT('%',#{search},'%')</when>
                    <otherwise>AND user_agent LIKE CONCAT('%',#{search},'%')</otherwise>
                </choose>
            </if>
        </where>
    </sql>
    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM <include refid="table"/> <include refid="filters"/>
    </select>
    <select id="selectPage" resultType="map">
        SELECT <include refid="columns"/> FROM <include refid="table"/> <include refid="filters"/>
        ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="selectOwned" resultType="map">
        SELECT * FROM <include refid="table"/> WHERE id=#{id}
        <if test="resource == 'users'">AND tenant_id=#{tenantId}</if>
    </select>
    <select id="selectById" resultType="map">
        SELECT <include refid="columns"/> FROM <include refid="table"/> WHERE id=#{id}
    </select>
    <insert id="insertResource">
        INSERT INTO <include refid="table"/>
        <foreach collection="values" index="column" item="value" open="(" separator="," close=")">${column}</foreach>
        VALUES
        <foreach collection="values" item="value" open="(" separator="," close=")">#{value}</foreach>
    </insert>
    <update id="updateResource">
        UPDATE <include refid="table"/> SET
        <foreach collection="values" index="column" item="value" separator=",">${column}=#{value}</foreach>
        WHERE id=#{id}
    </update>

    <select id="countByTable" resultType="int">
        SELECT COUNT(*)
        FROM
        <choose>
            <when test="table == 'sys_user'">sys_user</when>
            <when test="table == 'sys_role'">sys_role</when>
            <when test="table == 'sys_menu'">sys_menu</when>
            <when test="table == 'sys_button'">sys_button</when>
            <otherwise>sys_user_session</otherwise>
        </choose>
        WHERE id = #{id}
    </select>

    <delete id="deleteUserRoles">DELETE FROM sys_user_role WHERE user_id = #{userId}</delete>
    <select id="countRoleUsers" resultType="int">SELECT COUNT(*) FROM sys_user_role WHERE role_id = #{roleId}</select>
    <delete id="deleteRoleButtons">DELETE FROM sys_role_button WHERE role_id = #{roleId}</delete>
    <delete id="deleteRoleMenus">DELETE FROM sys_role_menu WHERE role_id = #{roleId}</delete>
    <select id="countChildMenus" resultType="int">SELECT COUNT(*) FROM sys_menu WHERE parent_id = #{menuId}</select>
    <select id="countMenuButtons" resultType="int">SELECT COUNT(*) FROM sys_button WHERE menu_id = #{menuId}</select>
    <delete id="deleteMenuRoles">DELETE FROM sys_role_menu WHERE menu_id = #{menuId}</delete>
    <delete id="deleteButtonRoles">DELETE FROM sys_role_button WHERE button_id = #{buttonId}</delete>

    <delete id="deleteResource">
        DELETE FROM
        <include refid="table"/>
        WHERE id = #{id}
    </delete>

    <select id="findRoleCode" resultType="string">
        SELECT role_code FROM sys_role WHERE id = #{roleId}
    </select>
    <select id="lockSuperRole" resultType="long">
        SELECT id FROM sys_role WHERE role_code = 'R_SUPER' FOR UPDATE
    </select>
    <select id="countUserRole" resultType="int">
        SELECT COUNT(*) FROM sys_user_role WHERE user_id = #{userId} AND role_id = #{roleId}
    </select>
    <select id="countEnabledSuperUsers" resultType="int">
        SELECT COUNT(*)
        FROM sys_user_role ur
        JOIN sys_user u ON u.id = ur.user_id
        WHERE ur.role_id = #{roleId} AND u.status = 'ENABLED'
    </select>
    <select id="countEnabledUser" resultType="int">
        SELECT COUNT(*) FROM sys_user WHERE id = #{userId} AND status = 'ENABLED'
    </select>
    <insert id="insertUserRole">
        INSERT INTO sys_user_role (id, user_id, role_id, create_by, modify_by)
        VALUES (#{id}, #{userId}, #{roleId}, #{createBy}, #{modifyBy})
    </insert>
    <select id="findButtonMenuId" resultType="long">
        SELECT menu_id FROM sys_button WHERE id = #{buttonId}
    </select>
    <select id="findMenuParentId" resultType="long">
        SELECT parent_id FROM sys_menu WHERE id = #{menuId}
    </select>
    <insert id="insertRoleMenu">
        INSERT INTO sys_role_menu (id, role_id, menu_id) VALUES (#{id}, #{roleId}, #{menuId})
    </insert>
    <insert id="insertRoleButton">
        INSERT INTO sys_role_button (id, role_id, button_id) VALUES (#{id}, #{roleId}, #{buttonId})
    </insert>
    <select id="findSessionUserId" resultType="long">
        SELECT user_id FROM sys_user_session WHERE id = #{sessionId} AND tenant_id = #{tenantId}
    </select>
    <select id="findRoleIdsByUser" resultType="long">
        SELECT role_id FROM sys_user_role WHERE user_id = #{userId}
    </select>
    <select id="findMenuIdsByRole" resultType="long">
        SELECT menu_id FROM sys_role_menu WHERE role_id = #{roleId}
    </select>
    <select id="findButtonIdsByRole" resultType="long">
        SELECT button_id FROM sys_role_button WHERE role_id = #{roleId}
    </select>
    <select id="findActiveSessionIds" resultType="long">
        SELECT id FROM sys_user_session WHERE user_id = #{userId} AND status = 'ACTIVE'
    </select>
    <select id="findSuperRoleIds" resultType="long">
        SELECT id FROM sys_role WHERE role_code = 'R_SUPER'
    </select>
    <insert id="insertSuperMenu">
        INSERT IGNORE INTO sys_role_menu (id, role_id, menu_id) VALUES (#{id}, #{roleId}, #{menuId})
    </insert>
    <insert id="insertSuperButton">
        INSERT IGNORE INTO sys_role_button (id, role_id, button_id) VALUES (#{id}, #{roleId}, #{buttonId})
    </insert>
</mapper>
