<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xqy.nexusedu.ai.chat.mapper.AiChatMessageMapper">
    <select id="lastSequenceNo" resultType="int">
        SELECT COALESCE(MAX(sequence_no), 0) FROM ai_chat_message WHERE conversation_id = #{conversationId}
    </select>
</mapper>
