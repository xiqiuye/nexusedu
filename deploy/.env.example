# Copy to deploy/.env and replace every placeholder before the first deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=nexusedu
POSTGRES_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-third-long-random-password
INTERNAL_RPC_SECRET=replace-with-at-least-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
OPENAI_API_KEY=replace-with-provider-key
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
EMBEDDING_TOKEN=replace-with-embedding-token

# Public HTTP port and frontend build settings.
HTTP_PORT=80
VITE_BASE_URL=/
APP_VERSION=local
IMAGE_PREFIX=nexusedu

# Optional tuning.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_POSTGRES_TABLE=ai_knowledge_chunk
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
